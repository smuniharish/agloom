EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_MODEL=gpt-5.6-luna
POSTGRES_PASSWORD=
DATABASE_URL=
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=all-minilm
TARGET_PREVIEW_URL=http://target-preview
VALIDATION_EXECUTOR_URL=http://validation-executor:8080
# Worker and governance
STUDIO_WORKER_CONCURRENCY=2
STUDIO_SHUTDOWN_GRACE_SECONDS=45
STUDIO_REQUIRE_SEPARATE_APPROVER=false
# Optional strict agentbarrier JSON policy replacing the default studio policy:
STUDIO_POLICY_FILE=
# Run the worker inside the API process (single-process development only):
STUDIO_EMBEDDED_WORKER=false
STUDIO_BROWSER_VALIDATION=true
# Observability
AGLOOM_OBSERVABILITY_ENABLED=true
AGLOOM_LANGFUSE_ENABLED=true
AGLOOM_METRICS_HOST=0.0.0.0
AGLOOM_METRICS_PORT=9469
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Identity
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
OIDC_DEMO_USERNAME=
OIDC_DEMO_PASSWORD=
OIDC_DEMO_TENANT=
OIDC_ISSUER=http://localhost:8088/realms/agloom
OIDC_AUDIENCE=product-studio
OIDC_JWKS_URI=http://localhost:8088/realms/agloom/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256
VITE_OIDC_URL=http://localhost:8088
VITE_OIDC_REALM=agloom
VITE_OIDC_CLIENT_ID=product-studio
# Required only when upgrading a database whose rows predate revision 0003
# (the owner assigned to rows created before tenant ownership existed):
STUDIO_BACKFILL_TENANT_ID=
STUDIO_BACKFILL_USER_ID=