# Playwright's image provides Chromium, its system libraries, and Node.js for
# the stdio MCP servers; uv installs Python 3.14 and the locked dependencies.
FROM mcr.microsoft.com/playwright:v1.63.0-noble
COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /uvx /bin/

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=3.14 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    MCP_SERVER_LAUNCHER=installed \
    BROWSER_EXECUTABLE=/usr/local/bin/chromium \
    BROWSER_SANDBOX=false

# Keep these versions in sync with backend/mcp_servers.py.
RUN npm install --global \
       @modelcontextprotocol/server-filesystem@2026.8.31 \
       @modelcontextprotocol/server-everything@2026.8.31 \
       @playwright/mcp@0.0.83 \
    && ln -s "$(find /ms-playwright -type f -path '*/chrome-linux*/chrome' | head -n 1)" \
       /usr/local/bin/chromium

WORKDIR /workspace
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY examples/engineering_change_investigator/pyproject.toml \
     examples/engineering_change_investigator/uv.lock \
     examples/engineering_change_investigator/
RUN uv sync --project examples/engineering_change_investigator --frozen --no-dev
COPY examples/engineering_change_investigator examples/engineering_change_investigator

WORKDIR /workspace/examples/engineering_change_investigator
EXPOSE 8000 9468
CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000"]
