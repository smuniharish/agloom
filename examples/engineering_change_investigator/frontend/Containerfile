FROM node:22-alpine AS build
WORKDIR /app
COPY examples/engineering_change_investigator/frontend/package*.json ./
RUN npm install
COPY examples/engineering_change_investigator/frontend ./
RUN npm run build

FROM nginx:1.27-alpine
COPY examples/engineering_change_investigator/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
