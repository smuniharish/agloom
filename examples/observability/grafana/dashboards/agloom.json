    {
      "id": 5,
      "type": "timeseries",
      "title": "Execution failure ratio (10m)",
      "description": "Share of finished executions that failed over the last 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
