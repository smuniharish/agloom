  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"agloom(_.+)?_events_total\"}, job)",
          "refId": "jobs"
        },
        "definition": "label_values({__name__=~\"agloom(_.+)?_events_total\"}, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
