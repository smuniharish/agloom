    {
      "id": 2,
      "type": "timeseries",
      "title": "Executions by status",
      "description": "Finished executions per second: completed, failed, paused, or cancelled.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (job, status) (rate({__name__=~\"agloom(_.+)?_executions_total\", job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
