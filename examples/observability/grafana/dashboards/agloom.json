        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "100 * sum by (job) (rate({__name__=~\"agloom(_.+)?_executions_total\", job=~\"$job\", status=\"failed\"}[10m])) / clamp_min(sum by (job) (rate({__name__=~\"agloom(_.+)?_executions_total\", job=~\"$job\"}[10m])), 1e-9)",
          "legendFormat": "{{job}}",
          "refId": "A"
