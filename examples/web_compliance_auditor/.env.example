# Copy to .env (git-ignored) and fill in the secrets. Never commit real values.

# OpenAI-compatible model
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_MODEL=gpt-5.6-luna

# Compose PostgreSQL password (the backend's DATABASE_URL is derived from it)
POSTGRES_PASSWORD=

# Local backend only (compose sets these for the containers)
# DATABASE_URL=postgresql://compliance:<password>@127.0.0.1:55433/compliance
# OLLAMA_URL=http://127.0.0.1:11435
# BROWSER_CHANNEL=chrome

# Optional
OLLAMA_EMBED_MODEL=all-minilm
METRICS_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse-web:3000
