# Real OpenAI-compatible model used by the examples.
EXPLABS_API_KEY=replace-with-your-api-key
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_MODEL=gpt-5.6-luna

# Agloom metrics exporter.
AGLOOM_METRICS_HOST=127.0.0.1
AGLOOM_METRICS_PORT=9464

# Langfuse SDK connection. These project keys may be pre-provisioned below.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=replace-with-a-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-a-langfuse-secret-key

# Self-hosted observability stack. Generate unique values before starting it.
LANGFUSE_NEXTAUTH_SECRET=replace-with-a-random-secret
LANGFUSE_SALT=replace-with-a-random-salt
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-characters
LANGFUSE_POSTGRES_PASSWORD=replace-with-a-database-password
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-a-clickhouse-password
LANGFUSE_REDIS_PASSWORD=replace-with-a-redis-password
LANGFUSE_MINIO_PASSWORD=replace-with-an-object-store-password
LANGFUSE_INIT_ORG_ID=agloom
LANGFUSE_INIT_ORG_NAME=Agloom
LANGFUSE_INIT_PROJECT_ID=agloom
LANGFUSE_INIT_PROJECT_NAME=Agloom
LANGFUSE_INIT_USER_EMAIL=replace-with-an-email
LANGFUSE_INIT_USER_NAME=Agloom Developer
LANGFUSE_INIT_USER_PASSWORD=replace-with-a-login-password

